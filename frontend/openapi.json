                  },
                  "type": "array",
                  "title": "Response List Teams Teams Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "teams"
        ],
        "summary": "Create Team",
