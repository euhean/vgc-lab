          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "login": {
            "type": "string",
            "title": "Login",
            "description": "Username or email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "login",
          "password"
        ],
        "title": "LoginRequest"
      },
      "RefreshRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest"
      },
      "SharedTeamOut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "format": {
            "type": "string",
            "title": "Format"
          },
          "paste": {
            "type": "string",
            "title": "Paste"
          },
          "owner": {
            "type": "string",
            "title": "Owner"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "name",
          "format",
          "paste",
          "owner",
          "updated_at"
        ],
        "title": "SharedTeamOut",
        "description": "What anyone with a share link can see: no ids or emails."
      },
      "SimulationIn": {
        "properties": {
          "team_id": {
            "type": "integer",
            "title": "Team Id"
          },
          "opponent_team_id": {
            "type": "integer",
            "title": "Opponent Team Id"
          },
          "games": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Games",
            "default": 100
          }
        },
        "type": "object",
        "required": [
          "team_id",
          "opponent_team_id"
        ],
        "title": "SimulationIn"
      },
      "SimulationOut": {
        "properties": {
          "games": {
            "type": "integer",
            "title": "Games"
          },
          "wins": {
            "type": "integer",
            "title": "Wins"
          },
          "losses": {
            "type": "integer",
            "title": "Losses"
          },
          "ties": {
            "type": "integer",
            "title": "Ties"
          },
          "win_rate": {
            "type": "number",
            "title": "Win Rate",
            "description": "Share of games won (0-1)"
          },
          "win_rate_low": {
            "type": "number",
            "title": "Win Rate Low",
            "description": "Lower bound of the 95% confidence interval"
          },
          "win_rate_high": {
            "type": "number",
            "title": "Win Rate High",
            "description": "Upper bound of the 95% confidence interval"
          }
        },
        "type": "object",
        "required": [
          "games",
          "wins",
          "losses",
          "ties",
          "win_rate",
          "win_rate_low",
          "win_rate_high"
        ],
        "title": "SimulationOut"
      },
      "TeamIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Name"
          },
          "format": {
            "type": "string",
            "maxLength": 32,
            "title": "Format",
            "default": "gen9vgc"
          },
          "paste": {
            "type": "string",
            "maxLength": 20000,
            "title": "Paste",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "TeamIn"
      },
      "TeamOut": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Name"
          },
          "format": {
            "type": "string",
            "maxLength": 32,
            "title": "Format",
            "default": "gen9vgc"
          },
          "paste": {
            "type": "string",
            "maxLength": 20000,
            "title": "Paste",
            "default": ""
          },
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "share_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Share Id"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "name",
          "id",
          "share_id",
          "updated_at"
        ],
        "title": "TeamOut"
      },
      "Token": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "refresh_token"
        ],
        "title": "Token"
      },
      "UsageEntry": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Showdown id, e.g. 'sitrusberry', or a spread 'Careful:252/4/0/0/252/0'"
          },
          "share": {
            "type": "number",
            "title": "Share",
            "description": "Share of this Pok\u00e9mon's sets that have it (0-1)"
          }
        },
        "type": "object",
        "required": [
          "id",
          "share"
        ],
        "title": "UsageEntry"
      },
      "UsagePokemonOut": {
        "properties": {
          "rank": {
            "type": "integer",
            "title": "Rank"
          },
          "species": {
            "type": "string",
            "title": "Species"
          },
          "usage": {
            "type": "number",
            "title": "Usage",
            "description": "Share of teams that use it (0-1)"
          },
          "sets": {
            "additionalProperties": {
              "items": {
                "$ref": "#/components/schemas/UsageEntry"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Sets",
            "description": "Most common moves, items, abilities, spreads and Tera types, most common first"
          }
        },
        "type": "object",
        "required": [
          "rank",
          "species",
          "usage",
          "sets"
        ],
        "title": "UsagePokemonOut"
      },
      "UsageReportDetail": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "format": {
            "type": "string",
            "title": "Format"
          },
          "month": {
            "type": "string",
            "title": "Month",
            "description": "YYYY-MM"
          },
          "rating": {
            "type": "integer",
            "title": "Rating",
            "description": "Smogon's rating cutoff"
          },
          "battles": {
            "type": "integer",
            "title": "Battles"
          },
          "loaded_at": {
            "type": "string",
            "format": "date-time",
            "title": "Loaded At"
          },
          "pokemon": {
            "items": {
              "$ref": "#/components/schemas/UsagePokemonOut"
            },
            "type": "array",
            "title": "Pokemon"
          }
        },
        "type": "object",
        "required": [
          "id",
          "format",
          "month",
          "rating",
          "battles",
          "loaded_at",
          "pokemon"
        ],
        "title": "UsageReportDetail"
      },
      "UsageReportOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "format": {
            "type": "string",
            "title": "Format"
          },
          "month": {
            "type": "string",
            "title": "Month",
            "description": "YYYY-MM"
          },
          "rating": {
            "type": "integer",
            "title": "Rating",
            "description": "Smogon's rating cutoff"
          },
          "battles": {
