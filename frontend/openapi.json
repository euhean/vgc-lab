        "tags": [
          "teams"
        ],
        "summary": "Unshare Team",
        "description": "Removes the public link; the old link stops working.",
        "operationId": "unshare_team_teams__team_id__share_delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Team Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
