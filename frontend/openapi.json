              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/meta/reports": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "List Reports",
        "description": "Public: every loaded usage report, newest month first.",
        "operationId": "list_reports_meta_reports_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UsageReportOut"
                  },
                  "type": "array",
                  "title": "Response List Reports Meta Reports Get"
                }
              }
            }
          }
        }
      }
    },
    "/meta/reports/{report_id}": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Read Report",
        "description": "Public: a report with its `limit` most used Pok\u00e9mon and their most common sets.",
        "operationId": "read_report_meta_reports__report_id__get",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Report Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 30,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageReportDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/battles/simulate": {
      "post": {
        "tags": [
          "battles"
        ],
        "summary": "Simulate Games",
